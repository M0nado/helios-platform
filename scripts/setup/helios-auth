#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
profile="$root/config/integrations/identity-profile.json"

usage() {
  cat <<'EOF'
Usage:
  helios-auth [--status|--interactive] [--repo OWNER/REPO] [--subscription ID]
  helios-auth github status
  helios-auth github create-pr --issue ID --title TITLE --body-file FILE --publish
  helios-auth azure-devops status
  helios-auth azure-devops configure [--organization URL] [--project NAME]
  helios-auth azure-devops create-pr --repository NAME --work-item ID [--source-branch BRANCH] [--target-branch BRANCH]

Authentication remains provider-issued: browser/device login locally, OIDC in CI,
managed identity in Azure, and a narrowly installed GitHub App for cross-repository work.
No token is generated, displayed, or stored by this command.
EOF
}

json_value() {
  python3 - "$profile" "$1" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
for part in sys.argv[2].split("."):
    value = value[part]
print(value)
PY
}

print_state() { printf '%-27s %s\n' "$1" "$2"; }

github_status() {
  local failures=0 expected_repo remote_url branch
  expected_repo="$(json_value github.repository)"
  branch="$(git -C "$root" branch --show-current)"
  remote_url="$(git -C "$root" remote get-url origin 2>/dev/null || true)"

  if command -v gh >/dev/null 2>&1; then print_state "GitHub CLI" "installed"; else print_state "GitHub CLI" "missing"; failures=1; fi
  if gh auth status --hostname github.com >/dev/null 2>&1; then print_state "GitHub session" "provider-authenticated"; else print_state "GitHub session" "run helios-auth --interactive"; failures=1; fi
  if [[ "$remote_url" =~ ^(https://github.com/|git@github.com:)${expected_repo}(\.git)?$ ]]; then
    print_state "Canonical origin" "$expected_repo"
  else
    print_state "Canonical origin" "missing or mismatched"
    failures=1
  fi
  if [[ -n "$branch" && "$branch" != "main" && "$branch" != "master" ]]; then print_state "Feature branch" "$branch"; else print_state "Feature branch" "required"; failures=1; fi
  if [[ -z "$(git -C "$root" status --porcelain=v1)" ]]; then print_state "Working tree" "clean"; else print_state "Working tree" "dirty"; failures=1; fi
  return "$failures"
}

github_create_pr() {
  local issue="" title="" body_file="" publish=false expected_repo branch linked_body
  while (($#)); do
    case "$1" in
      --issue) issue="${2:?--issue requires an ID}"; shift 2 ;;
      --title) title="${2:?--title requires text}"; shift 2 ;;
      --body-file) body_file="${2:?--body-file requires a path}"; shift 2 ;;
      --publish) publish=true; shift ;;
      *) echo "Unknown GitHub create-pr option: $1" >&2; exit 2 ;;
    esac
  done
  [[ "$issue" =~ ^[0-9]+$ ]] || { echo "--issue must be a numeric scoped GitHub issue." >&2; exit 2; }
  [[ -n "$title" && -f "$body_file" ]] || { echo "--title and an existing --body-file are required." >&2; exit 2; }
  [[ "$publish" == true ]] || { echo "Refusing provider mutation without explicit --publish." >&2; exit 2; }
  github_status >/dev/null || { echo "GitHub PR preflight failed; run 'helios-auth github status'." >&2; exit 1; }

  expected_repo="$(json_value github.repository)"
  branch="$(git -C "$root" branch --show-current)"
  git -C "$root" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 || {
    echo "Branch '$branch' is not published to the canonical origin; push it explicitly before creating the PR." >&2
    exit 1
  }
  linked_body="$(mktemp "${TMPDIR:-/tmp}/helios-pr-body.XXXXXX")"
  trap 'rm -f "$linked_body"' RETURN
  cat "$body_file" > "$linked_body"
  printf '\n\nCloses #%s\n' "$issue" >> "$linked_body"
  gh pr create --repo "$expected_repo" --base main --head "$branch" --draft \
    --title "$title" --body-file "$linked_body"
}

azdo_status() {
  local failures=0 org="${HELIOS_AZDO_ORGANIZATION:-}" project="${HELIOS_AZDO_PROJECT:-}"
  if command -v az >/dev/null 2>&1; then print_state "Azure CLI" "installed"; else print_state "Azure CLI" "missing"; failures=1; fi
  if az extension show --name azure-devops >/dev/null 2>&1; then print_state "Azure DevOps extension" "installed"; else print_state "Azure DevOps extension" "not installed"; failures=1; fi
  if [[ -n "$org" ]]; then print_state "Azure DevOps org" "configured"; else print_state "Azure DevOps org" "set HELIOS_AZDO_ORGANIZATION"; failures=1; fi
  if [[ -n "$project" ]]; then print_state "Azure DevOps project" "configured"; else print_state "Azure DevOps project" "set HELIOS_AZDO_PROJECT"; failures=1; fi
  if [[ -n "${HELIOS_AZDO_SERVICE_CONNECTION:-}" ]]; then print_state "Federated connection" "configured"; else print_state "Federated connection" "set HELIOS_AZDO_SERVICE_CONNECTION"; failures=1; fi
  return "$failures"
}

azdo_configure() {
  local org="${HELIOS_AZDO_ORGANIZATION:-}" project="${HELIOS_AZDO_PROJECT:-}"
  while (($#)); do
    case "$1" in
      --organization) org="${2:?--organization requires a URL}"; shift 2 ;;
      --project) project="${2:?--project requires a name}"; shift 2 ;;
      *) echo "Unknown Azure DevOps option: $1" >&2; exit 2 ;;
    esac
  done
  command -v az >/dev/null || { echo "Azure CLI is not installed." >&2; exit 127; }
  az account show --only-show-errors >/dev/null || { echo "Run helios-auth --interactive first." >&2; exit 1; }
  az extension add --name azure-devops --only-show-errors
  [[ -n "$org" && -n "$project" ]] || { echo "Organization and project are required." >&2; exit 2; }
  az devops configure --defaults organization="$org" project="$project"
  echo "Azure DevOps defaults configured. An administrator must approve the workload-identity service connection."
}

azdo_create_pr() {
  local repository="" work_item="" source="$(git branch --show-current)" target="main"
  while (($#)); do
    case "$1" in
      --repository) repository="${2:?}"; shift 2 ;;
      --work-item) work_item="${2:?}"; shift 2 ;;
      --source-branch) source="${2:?}"; shift 2 ;;
      --target-branch) target="${2:?}"; shift 2 ;;
      *) echo "Unknown create-pr option: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$repository" && "$work_item" =~ ^[0-9]+$ ]] || { echo "--repository and numeric --work-item are required." >&2; exit 2; }
  az repos pr create --repository "$repository" --source-branch "$source" --target-branch "$target" \
    --work-items "$work_item" --draft true --title "[$work_item] $source" \
    --description "Review-gated HELIOS change linked to work item $work_item."
}

if [[ "${1:-}" == "github" ]]; then
  shift
  case "${1:-status}" in
    status) shift || true; github_status ;;
    create-pr) shift; github_create_pr "$@" ;;
    *) usage >&2; exit 2 ;;
  esac
  exit
elif [[ "${1:-}" == "azure-devops" ]]; then
  shift
  case "${1:-status}" in
    status) shift || true; azdo_status ;;
    configure) shift; azdo_configure "$@" ;;
    create-pr) shift; azdo_create_pr "$@" ;;
    *) usage >&2; exit 2 ;;
  esac
  exit
fi

repo="$(json_value github.repository)"
args=()
while (($#)); do
  case "$1" in
    --status|--interactive) args+=("$1"); shift ;;
    --repo|--subscription) args+=("$1" "${2:?$1 requires a value}"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if ((${#args[@]} == 0)); then args=(--status); fi
exec "$root/scripts/setup/configure-cloud-auth.sh" --repo "$repo" "${args[@]}"
