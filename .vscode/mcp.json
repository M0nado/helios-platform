{
  "servers": {
    "helios-local-dev": {
      "type": "http",
      "url": "http://127.0.0.1:5080/mcp"
    },
    "azure-mcp-readonly": {
      "command": "azmcp",
      "args": [
        "server",
        "start",
        "--read-only",
        "--mode",
        "namespace",
        "--namespace",
        "subscription",
        "--namespace",
        "group",
        "--namespace",
        "containerapps",
        "--namespace",
        "applicationinsights",
        "--namespace",
        "monitor",
        "--namespace",
        "foundryextensions",
        "--namespace",
        "quota",
        "--namespace",
        "pricing"
      ]
    },
    "azure-devops-readonly": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/${input:azureDevOpsOrganization}",
      "headers": {
        "X-MCP-Toolsets": "repos,wit,pipelines,wiki",
        "X-MCP-Readonly": "true"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp"
    }
  },
  "inputs": [
    {
      "id": "azureDevOpsOrganization",
      "type": "promptString",
      "description": "Azure DevOps organization name",
      "default": "Heli0sDev"
    }
  ]
}
