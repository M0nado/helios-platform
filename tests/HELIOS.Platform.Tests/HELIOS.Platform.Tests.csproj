<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="$(MoqVersion)" />
    <!-- NOTE: coverlet.collector 6.0.0 → 10.0.0 is a major version bump - NOT updated -->
    <PackageReference Include="coverlet.collector" Version="$(CoverletCollectorVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Phase10/Quarantine/**/*.cs" />
    <Compile Remove="ApiSecurity/**/*.cs" />
    <Compile Remove="AI/**/*.cs" />
    <Compile Remove="CLI/**/*.cs" />
    <Compile Remove="CompatibilityTests.cs" />
    <Compile Remove="Dashboard/**/*.cs" />
    <Compile Remove="DeveloperDashboardTests.cs" />
    <Compile Remove="EndToEndTests.cs" />
    <Compile Remove="GlobalIntelligenceServicesTests.cs" />
    <Compile Remove="HeliosDeploymentTests.cs" />
    <Compile Remove="IntegrationTests.cs" />
    <Compile Remove="Integration/**/*.cs" />
    <Compile Remove="Intelligence/**/*.cs" />
    <Compile Remove="Malwarebytes/**/*.cs" />
    <Compile Remove="PerformanceTests.cs" />
    <Compile Remove="Phase1ServiceTests.cs" />
    <Compile Remove="Phase3APIWebTests.cs" />
    <Compile Remove="Phase3ProductionBenchmarks.cs" />
    <Compile Remove="Phase3ProductionTests.cs" />
    <Compile Remove="Phase3Tier4SecurityDisasterRecoveryTests.cs" />
    <Compile Remove="Phase5/AdvancedML/**/*.cs" />
    <Compile Remove="Phase6AdvancedOptimizationTests.cs" />
    <Compile Remove="ScalingValidation.cs" />
    <Compile Remove="ScalingTestTools.cs" />
    <Compile Remove="SecurityTests.cs" />
    <Compile Remove="Security/**/*.cs" />
    <Compile Remove="Presentation/Studio/**/*.cs" />
