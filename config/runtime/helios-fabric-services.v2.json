{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0.0",
  "fabricId": "monadoblade-delivery-fabric",
  "contractMode": "deterministic-and-versioned",
  "libraries": [
    { "id": "policy-contract", "package": "HELIOS.Contracts.Policy", "version": "2.0.0" },
    { "id": "evidence-contract", "package": "HELIOS.Contracts.Evidence", "version": "2.0.0" },
    { "id": "control-client", "package": "HELIOS.Control.Client", "version": "2.0.0" },
    { "id": "shellkit", "package": "HELIOS.ShellKit", "version": "2.0.0" },
    { "id": "renderer", "package": "HELIOS.Renderer.WinUI", "version": "2.0.0" },
    { "id": "chroma", "package": "HELIOS.Chroma", "version": "2.0.0" },
    { "id": "wyvern", "package": "HELIOS.Wyvern", "version": "2.0.0" },
    { "id": "usb-device-broker-requests", "package": "HELIOS.USB.DeviceBroker.Contracts", "version": "2.0.0" }
  ],
  "profileContracts": {
    "active": "config/profiles/monadoblade-profiles.v2.json",
    "legacyInput": "config/profiles/monadoblade-profiles.v1.json",
    "migration": "config/profiles/monadoblade-profiles.migration.v1-to-v2.json"
  },
  "surfaceContracts": {
    "shell": "config/gui/monado-profile-shell.v2.json",
    "usbWizard": "config/usb/monadoblade-usb-wizard.v1.json",
    "alvisCapabilities": "config/aihub/alvis-capabilities.v1.json",
    "integrationProjection": "config/integrations/monadoblade-collaboration-projection.v1.json"
  },
  "governance": {
    "failClosed": true,
    "idempotentWritesOnly": true,
    "approvalRequiredForPrivilegedApply": true,
    "noDirectExecutorSurfaceInPresentationLayers": true
  }
}
