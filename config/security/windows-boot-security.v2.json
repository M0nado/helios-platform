{
  "schemaVersion": 2,
  "name": "HELIOS Windows boot security and rootkit recovery",
  "defaultMode": "audit",
  "startup": {
    "postureAuditEnabled": true,
    "automaticRemediation": false,
    "automaticOfflineScan": false,
    "reportDirectory": "%LOCALAPPDATA%\\HELIOS\\Reports\\BootSecurity"
  },
  "scheduledScans": {
    "dailyQuickScanDefault": true,
    "dailyQuickScanTime": "12:30",
    "weeklyFullScanDefault": false,
    "fullScanRequiresExplicitOptIn": true
  },
  "defender": {
    "realTimeProtection": true,
    "behaviorMonitoring": true,
    "scriptScanning": true,
    "ioavProtection": true,
    "archiveScanning": true,
    "removableDriveScanning": true,
    "puaProtection": "enabled",
    "networkProtection": "enabled",
    "controlledFolderAccessDefault": "audit",
    "tamperProtection": "report-only"
  },
  "attackSurfaceReduction": {
    "defaultAction": "audit",
    "strictAction": "block",
    "rules": [
      { "id": "56a863a9-875e-4185-98a7-b882c64b5ce5", "name": "Block abuse of exploited vulnerable signed drivers" },
      { "id": "9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2", "name": "Block credential stealing from LSASS" },
      { "id": "e6db77e5-3df2-4cf1-b95a-636979351e5b", "name": "Block persistence through WMI event subscription" },
      { "id": "5beb7efe-fd9a-4556-801d-275e5ffc04cc", "name": "Block execution of potentially obfuscated scripts" },
      { "id": "d3e037e1-3eb8-44c8-a917-57927947596d", "name": "Block JavaScript or VBScript from launching downloaded executable content" },
      { "id": "c1db55ab-c21a-4637-bb3f-a12568109d35", "name": "Use advanced protection against ransomware" },
      { "id": "d4f940ab-401b-4efc-aadc-ad5f3c50688a", "name": "Block Office applications from creating child processes" },
      { "id": "3b576869-a4ec-4529-8536-b80a7769e899", "name": "Block Office applications from creating executable content" },
      { "id": "75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84", "name": "Block Office applications from injecting code into other processes" },
      { "id": "be9ba2d9-53ea-4cdc-84e5-9b1eeee46550", "name": "Block executable content from email client and webmail" },
      { "id": "b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4", "name": "Block untrusted and unsigned processes that run from USB" }
    ]
  },
  "bootChain": {
    "secureBoot": "audit-and-firmware-handoff",
    "tpm2": "audit-and-firmware-handoff",
    "memoryIntegrity": "explicit-opt-in",
    "credentialGuard": "explicit-opt-in",
    "lsaProtection": "explicit-opt-in",
    "vulnerableDriverBlocklist": "explicit-apply"
  },
  "rootkitRecovery": {
    "provider": "Microsoft Defender Offline",
    "requiresWinRE": true,
    "requiresKnownBitLockerState": true,
    "requiresRecoveryEvidenceWhenProtected": true,
    "bitLockerSuspendReboots": 1,
    "confirmationPhrase": "RUN HELIOS OFFLINE ROOTKIT SCAN",
    "automaticRebootLoop": false
  },
  "prohibited": [
    "disk-formatting",
    "partition-mutation",
    "tpm-clear",
    "secure-boot-key-reset",
    "permanent-bitlocker-disable",
    "broad-defender-exclusions",
    "automatic-offline-scan",
    "automatic-reboot-loop"
  ]
}
