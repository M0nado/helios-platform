{
  "contractSchema": "schemas/hermes-xcore-environment-bindings-v1.schema.json",
  "schemaVersion": "1.0.0",
  "contractId": "helios-hermes-xcore-environment-bindings-v1",
  "environments": [
    {
      "name": "x-tier-dev",
      "tier": "development",
      "eventEnvironment": "development",
      "deploymentWorkflow": "helios-cloud-deploy.yml",
      "approvalRequired": true
    },
    {
      "name": "x-tier-xcore",
      "tier": "evaluation",
      "eventEnvironment": "test",
      "deploymentWorkflow": "helios-cloud-deploy.yml",
      "approvalRequired": true
    },
    {
      "name": "x-tier-prod",
      "tier": "production",
      "eventEnvironment": "production",
      "deploymentWorkflow": "helios-cloud-deploy.yml",
      "approvalRequired": true
    }
  ],
  "promotionGraph": [
    {
      "from": "x-tier-dev",
      "to": "x-tier-xcore",
      "requiresExactArtifactDigest": true,
      "requiresEvidenceLink": true
    },
    {
      "from": "x-tier-xcore",
      "to": "x-tier-prod",
      "requiresExactArtifactDigest": true,
      "requiresEvidenceLink": true
    }
  ],
  "hotfix": {
    "targetEnvironment": "x-tier-prod",
    "separateEnvironment": false,
    "requiresIncidentId": true,
    "requiresReason": true,
    "autoApprove": false,
    "autoDeploy": false
  },
  "immutableArtifactContinuity": {
    "required": true,
    "forbidRebuildAfterApproval": true,
    "requireTemplateAndRequestDigestMatch": true
  },
  "chaosAndRegressionPolicy": {
    "allowedChaosEnvironments": [
      "x-tier-dev",
      "x-tier-xcore"
    ],
    "forbidProductionChaos": true,
    "requirePromotionGatesForChaosRecommendations": true,
    "xcoreRegressionFailClosed": true,
    "requireReviewableRegressionEvidence": true
  }
}
