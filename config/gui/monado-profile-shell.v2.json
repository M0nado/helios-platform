{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.2.0",
  "shellId": "monadoblade-profile-shell",
  "inheritsFrom": "config/gui/monado-profile-shell.v1.json",
  "inheritance": {
    "mode": "overlay-readiness-and-wheel",
    "preserveSections": ["rendering", "scene", "blade", "quickSwitch", "profileThemes", "accessibility"]
  },
  "securityBoundary": {
    "runsAfterWindowsAuthentication": true,
    "replacesWindowsCredentialProvider": false,
    "networkRequiredForLogin": false,
    "fallbackShell": "safe-neutral"
  },
  "postAuthStateMachine": ["safe-boot", "identity-verified", "wheel-ready", "profile-selected", "readiness-check", "shell-ready"],
  "profileWheel": {
    "orientation": "radial",
    "selection": ["mouse", "keyboard", "controller", "touch"],
    "sectors": [
      { "profile": "core", "kanji": "核", "glyph": "CORE", "color": "#BBD7FF", "angle": 0 },
      { "profile": "developer", "kanji": "創", "glyph": "DEV", "color": "#00D8FF", "angle": 60 },
      { "profile": "studio", "kanji": "響", "glyph": "WAVE", "color": "#D64DFF", "angle": 120 },
      { "profile": "gamer", "kanji": "迅", "glyph": "PLAY", "color": "#62FF4A", "angle": 180 },
      { "profile": "ai-server", "kanji": "智", "glyph": "AI", "color": "#6D7B8D", "angle": 240 },
      { "profile": "sysadmin-offline", "kanji": "統", "glyph": "ROOT", "color": "#FFB000", "angle": 300, "hiddenUntilAuthorized": true }
    ]
  },
  "stateGuards": {
    "identityVerifiedRequiredBeforeWheel": true,
    "sysadminRequiresLocalOfflineAuthorization": true,
    "profilePolicyValidatedBeforeShellReady": true,
    "managedVolumesOnlineBeforeShellReady": true,
    "requiredServicesHealthyBeforeShellReady": true,
    "firewallPolicyLoadedBeforeShellReady": true,
    "readinessFailureState": "safe-neutral",
    "safeNeutralOnGuardFailure": true
  },
  "readinessChecks": [
    "profile-policy-valid",
    "required-volumes-online",
    "required-services-healthy",
    "firewall-policy-loaded"
  ]
}
