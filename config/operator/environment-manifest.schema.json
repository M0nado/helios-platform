{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.dev/operator/environment-manifest.schema.json",
  "title": "HELIOS operator environment manifest",
  "type": "object",
  "required": ["version", "environment", "declared"],
  "properties": {
    "version": { "const": "1.0" },
    "environment": { "type": "string", "enum": ["local", "development", "test", "staging", "production"] },
    "approvalAuthorities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "publicKeyPem"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "publicKeyPem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
        },
        "additionalProperties": false
      }
    },
    "declared": {
      "type": "object",
      "required": ["githubApps", "secretReads", "oidcSubjects"],
      "properties": {
        "githubApps": { "$ref": "#/$defs/uniqueNames" },
        "secretReads": { "$ref": "#/$defs/uniqueNames" },
        "oidcSubjects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^[^*?]+$" }
        }
      },
      "additionalProperties": false
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "uniqueNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "correlationId", "evidenceLinks"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "format": "uuid" },
        "evidenceLinks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      },
      "additionalProperties": false
    }
  }
}
