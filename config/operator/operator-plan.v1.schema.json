{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.dev/operator/operator-plan.v1.schema.json",
  "title": "HELIOS governed operator plan v1",
  "type": "object",
  "required": ["schemaVersion", "actor", "actions", "provenance", "confidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "actor": {
      "type": "object",
      "required": ["id", "githubLogin", "azurePrincipalId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "githubLogin": { "type": "string", "minLength": 1 },
        "azurePrincipalId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "identities": {
      "type": "object",
      "properties": {
        "development": { "type": "string", "minLength": 1 },
        "production": { "type": "string", "minLength": 1 }
      },
      "required": ["development", "production"],
      "additionalProperties": false
    },
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": { "type": { "type": "string", "minLength": 1 } },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "correlationId", "evidenceLinks"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "format": "uuid" },
        "evidenceLinks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      },
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
