{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.dev/operator/operator-plan.v1.schema.json",
  "title": "HELIOS governed operator plan v1",
  "type": "object",
  "required": ["schemaVersion", "environment", "actor", "actions", "provenance", "confidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "environment": { "type": "string", "enum": ["local", "development", "test", "staging", "production"] },
    "actor": {
      "type": "object",
      "required": ["id", "githubLogin", "azurePrincipalId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "githubLogin": { "type": "string", "minLength": 1 },
        "azurePrincipalId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "identities": {
      "type": "object",
      "properties": {
        "development": { "type": "string", "minLength": 1 },
        "production": { "type": "string", "minLength": 1 }
      },
      "required": ["development", "production"],
      "additionalProperties": false
    },
    "actions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
          "environment": { "type": "string", "enum": ["local", "development", "test", "staging", "production"] },
          "target": { "$ref": "#/$defs/boundedString" },
          "principalId": { "$ref": "#/$defs/boundedString" },
          "reviewer": { "$ref": "#/$defs/boundedString" },
          "approver": { "$ref": "#/$defs/boundedString" },
          "app": { "$ref": "#/$defs/boundedString" },
          "secret": { "$ref": "#/$defs/boundedString" },
          "subject": { "$ref": "#/$defs/boundedString" },
          "oidcSubject": { "$ref": "#/$defs/boundedString" },
          "image": { "$ref": "#/$defs/boundedString" },
          "ref": { "$ref": "#/$defs/boundedString" },
          "args": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } },
          "requiredReviews": { "type": "boolean" },
          "requirePullRequest": { "type": "boolean" },
          "requireStatusChecks": { "type": "boolean" },
          "enforceAdmins": { "type": "boolean" },
          "allowForcePushes": { "type": "boolean" },
          "allowDeletions": { "type": "boolean" },
          "requiredApprovingReviewCount": { "type": "integer", "minimum": 0 },
          "developmentIdentity": { "$ref": "#/$defs/boundedString" },
          "productionIdentity": { "$ref": "#/$defs/boundedString" }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "correlationId", "evidenceLinks"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "format": "uuid" },
        "evidenceLinks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      },
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "approvalEvidence": {
      "type": "object",
      "required": ["approverId", "approvedAt", "evidenceLinks"],
      "properties": {
        "approverId": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "evidenceLinks": { "$ref": "#/$defs/evidenceLinks" }
      },
      "additionalProperties": false
    },
    "rollbackEvidence": {
      "type": "object",
      "required": ["procedure", "evidenceLinks"],
      "properties": {
        "procedure": { "type": "string", "minLength": 1 },
        "evidenceLinks": { "$ref": "#/$defs/evidenceLinks" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "boundedString": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "evidenceLinks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}
