{
  "schemaVersion": "1.0",
  "requiredChecks": [
    "integration-stable-compatibility",
    "integration-contracts",
    "delivery-contracts"
  ],
  "automation": {
    "githubToken": "workflow-scoped",
    "crossRepositoryIdentity": "github-app-installation-token",
    "dependencyUpdates": "review-required",
    "autoMerge": false
  },
  "evidence": {
    "preserveCorrelationId": true,
    "dashboardSource": "check-and-artifact-metadata",
    "retentionDays": 14
  },
  "merge": {
    "protectedBranchRequired": true,
    "approvalsRequired": true,
    "previewArtifactsAllowed": false,
    "credentialsAllowed": false
  }
}
