{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "contractId": "monadoblade-delivery-fabric",
  "correlationId": "github-M0nado-helios-platform-issue-207",
  "authority": {
    "codeAndRelease": "M0nado/helios-platform",
    "crossRepositoryPolicy": "Heli0s-Dynamics/adaptive-multibrain-bootstrap",
    "identityContract": "config/profiles/monadoblade-profiles.v2.json",
    "shellContract": "config/gui/monado-profile-shell.v2.json",
    "environmentContract": "config/experience/monadoblade-living-environments.v1.json",
    "effectsContract": "config/experience/monadoblade-effects.v1.json",
    "engineRegistry": "config/aihub/monadoblade-engine-registry.v1.json",
    "storagePlan": "config/storage/monadoblade-storage-plan-template.v2.json"
  },
  "repositories": [
    {
      "name": "M0nado/helios-platform",
      "role": "canonical-platform",
      "status": "active",
      "owns": ["contracts", "policy", "release-integration", "validation", "evidence"]
    },
    {
      "name": "M0nado/helios-gui-framework",
      "role": "shared-winui-framework",
      "status": "existing-extraction-target",
      "owns": ["shell-kit", "profile-wheel", "taskbar", "flyouts", "account-surfaces", "alvis-ui"]
    },
    {
      "name": "M0nado/helios-monado-blade",
      "role": "cinematic-engine",
      "status": "existing-integration-target",
      "owns": ["monado-model", "aperture-animation", "cinematic-renderer", "environment-adapter"]
    },
    {
      "name": "M0nado/helios-ai-hub",
      "role": "ai-orchestration",
      "status": "existing-integration-target",
      "owns": ["model-adapters", "engine-registry", "evaluation-runtime", "foundry-connectors"]
    },
    {
      "name": "M0nado/helios-usb-wizard",
      "role": "local-usb-product",
      "status": "planned-gated-by-issue-149",
      "owns": ["device-inventory", "dry-run-storage-plan", "offline-bundle-preview", "rollback-evidence"]
    }
  ],
  "packages": [
    {
      "id": "HELIOS.Monadoblade.Contracts",
      "owner": "M0nado/helios-platform",
      "consumers": ["helios-gui-framework", "helios-monado-blade", "helios-ai-hub", "helios-usb-wizard"],
      "failureMode": "reject-unknown-contract-version"
    },
    {
      "id": "HELIOS.Monadoblade.ShellKit",
      "owner": "M0nado/helios-gui-framework",
      "consumers": ["helios-platform", "helios-usb-wizard"],
      "failureMode": "windows-native-safe-neutral"
    },
    {
      "id": "HELIOS.Monadoblade.Renderer",
      "owner": "M0nado/helios-monado-blade",
      "consumers": ["helios-gui-framework", "helios-usb-wizard-preview"],
      "failureMode": "static-background"
    },
    {
      "id": "HELIOS.Chroma.Adapter",
      "owner": "M0nado/helios-gui-framework",
      "consumers": ["shell-energy-bus"],
      "optional": true,
      "failureMode": "screen-preview-only"
    },
    {
      "id": "HELIOS.Wyvern.Audio",
      "owner": "M0nado/helios-gui-framework",
      "consumers": ["shell-energy-bus"],
      "optional": true,
      "failureMode": "silent"
    },
    {
      "id": "HELIOS.ALVIS.Surface",
      "owner": "M0nado/helios-gui-framework",
      "consumers": ["helios-platform", "helios-ai-hub"],
      "failureMode": "read-only-local-status"
    },
    {
      "id": "HELIOS.USB.DeviceBroker.Contracts",
      "owner": "M0nado/helios-platform",
      "consumers": ["helios-usb-wizard"],
      "failureMode": "inventory-only-no-apply"
    }
  ],
  "alvis": {
    "directExecutorToolsDenied": true,
    "toolClasses": [
      { "prefix": "search_", "effect": "read-only", "approval": "none" },
      { "prefix": "fetch_", "effect": "read-only", "approval": "none" },
      { "prefix": "plan_", "effect": "plan-only", "approval": "none" },
      { "prefix": "request_", "effect": "pending-approval", "approval": "human-required" }
    ],
    "sysAdmin": {
      "network": "denied",
      "providers": "local-approved-only",
      "effects": ["read-only", "plan-only"],
      "externalWrites": "denied"
    },
    "eventEnvelope": "config/integrations/event-contract.schema.json"
  },
  "collaborationProjection": {
    "github": {
      "role": "engineering-source-of-truth",
      "issue": "https://github.com/M0nado/helios-platform/issues/207",
