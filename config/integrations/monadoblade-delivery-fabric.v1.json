  "githubAutomation": {
    "branchPattern": "agent/monadoblade-*",
    "pullRequestDefault": "draft",
    "requiredValidation": ["contract-validator", "csharp-contract-build", "cpp-environment-smoke", "secret-pattern-scan"],
    "directToMainDenied": true,
    "forcePushDenied": true,
