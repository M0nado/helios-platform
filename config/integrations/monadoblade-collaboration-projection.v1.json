{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.1.0",
  "projectionId": "monadoblade-collaboration-evidence",
  "sourceOfTruth": "github",
  "eventContractSchema": "config/integrations/event-contract.schema.json",
  "requiredEnvelopeFields": [
    "schemaVersion",
    "eventId",
    "source",
    "eventType",
    "repository",
    "correlationId",
    "environment",
    "occurredAt",
    "dataClassification",
    "actor",
    "links",
    "payload"
  ],
  "requireSchemaValidationBeforeProjection": true,
  "requireEvidenceLinks": true,
  "requireCorrelationForTargetWrites": true,
  "projectableRecords": ["approved-pr-link", "approved-evidence-link"],
  "targets": ["linear", "slack", "teams", "sharepoint", "azure-devops"],
  "allowExecutionFromProjectedSystems": false,
  "targetBehavior": {
    "linear": "tracking-only",
    "slack": "notification-only",
    "teams": "notification-only",
    "sharepoint": "governed-evidence-storage",
    "azure-devops": "discovery-and-sync-only"
  }
}
