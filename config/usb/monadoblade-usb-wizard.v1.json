{
  "$schema": "../../schemas/monadoblade-usb-wizard.v1.schema.json",
  "version": "1.0.0",
  "wizardId": "monadoblade-usb-wizard",
  "defaultMode": "dry-run",
  "routes": {
    "inventory": "read-only",
    "storage-plan": "device-specific-plan-only",
    "apply": "approval-gated"
  },
  "boundaries": {
    "allowPhysicalDiskWriteWithoutApproval": false,
    "requireDeviceIdentityForStoragePlan": true,
    "recoveryWorkflowProfile": "sysadmin-offline",
    "quarantineWorkflowProfile": "sysadmin-offline",
    "recoveryIsNotAProfile": true,
    "quarantineIsNotAProfile": true
  }
}

