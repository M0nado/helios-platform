{
  "$schema": "../../../schemas/monadoblade/experience-fabric/v2/contract-instance.schema.json",
  "schemaVersion": "2.0.0",
  "contractId": "monado-sync-v2",
  "defaultMode": "propose-and-validate-only",
  "idempotency": {
    "algorithm": "sha256",
    "inputFields": ["routeId", "source.eventId", "target.system", "operation"],
    "normalization": "nfc+trim+length-prefixed-utf8",
    "keyTemplate": "sha256(normalized-length-prefixed:{routeId}:{source.eventId}:{target.system}:{operation})",
    "retention": "P30D",
    "duplicateOutcome": "return-recorded-result-without-repeating-side-effect"
  },
  "envelope": {
    "schemaVersion": "1.0",
    "requiredFields": [
      "schemaVersion",
      "eventId",
      "source",
      "eventType",
      "repository",
      "correlationId",
      "environment",
      "occurredAt",
      "dataClassification",
      "links",
      "payload"
    ]
  },
  "systems": {
    "github": { "mode": "authoritative-source" },
    "linear": { "mode": "work-authority" },
    "slack": { "mode": "status-only", "maxCheckpointsPerBranch": 1 },
    "sharepoint": { "mode": "governed-evidence" },
    "azure-devops": { "mode": "read-only-mirror-until-separate-approved-identity" },
    "adobe-design": { "mode": "approved-original-assets-and-link-evidence-only" }
  },
  "prohibitions": [
    "direct-to-main-write",
    "implicit-external-message-side-effect",
    "azure-apply-from-runtime",
    "tenant-consent-from-runtime",
    "direct-production-deployment",
    "external-write-without-approval"
  ]
}
