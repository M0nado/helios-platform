{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-openai-proposal-v2.json",
  "title": "Monado OpenAI Proposal V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposalId",
    "profileId",
    "correlationId",
    "requestedBy",
    "riskLevel",
    "actionType",
    "summary",
    "evidenceLinks",
    "expiresAtUtc",
    "rollbackPlan",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "proposalId": { "type": "string", "minLength": 8 },
    "profileId": {
      "type": "string",
      "enum": ["core", "developer", "gamer", "studio", "personal", "sysops", "ai-server", "sysadmin"]
    },
    "correlationId": { "type": "string", "minLength": 4 },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["human", "agent", "workflow"] },
        "id": { "type": "string", "minLength": 2 }
      }
    },
    "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "actionType": {
      "type": "string",
      "enum": ["read", "analysis", "proposal", "privileged-proposal", "deployment-proposal", "rollback-proposal"]
    },
    "summary": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "evidenceLinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "href"],
        "properties": {
          "rel": { "type": "string", "minLength": 2 },
          "href": { "type": "string", "format": "uri" }
        }
      }
    },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "rollbackPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "steps"],
      "properties": {
        "strategy": { "type": "string", "minLength": 4 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired"] },
        "reference": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actionType": {
            "enum": ["privileged-proposal", "deployment-proposal", "rollback-proposal"]
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "required": { "const": true }
            }
          }
        }
      }
    }
  ]
}
