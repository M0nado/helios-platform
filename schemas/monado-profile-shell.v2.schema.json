{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.local/monado-profile-shell.v2.schema.json",
  "title": "Monado profile shell v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "shellId",
    "securityBoundary",
    "postAuthStateMachine",
    "profileWheel",
    "stateGuards"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "2.0.0"
    },
    "shellId": {
      "const": "monadoblade-profile-shell"
    },
    "securityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runsAfterWindowsAuthentication",
        "replacesWindowsCredentialProvider",
        "networkRequiredForLogin",
        "fallbackShell"
      ],
      "properties": {
        "runsAfterWindowsAuthentication": {
          "const": true
        },
        "replacesWindowsCredentialProvider": {
          "const": false
        },
        "networkRequiredForLogin": {
          "const": false
        },
        "fallbackShell": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postAuthStateMachine": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profileWheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "selection",
        "sectors"
      ],
      "properties": {
        "orientation": {
          "const": "radial"
        },
        "selection": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mouse",
              "keyboard",
              "controller",
              "touch"
            ]
          }
        },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "kanji",
              "glyph",
              "color",
              "angle"
            ],
            "properties": {
              "profile": {
                "enum": [
                  "core",
                  "developer",
                  "studio",
                  "gamer",
                  "ai-server",
                  "sysadmin-offline"
                ]
              },
              "kanji": {
                "type": "string",
                "minLength": 1
              },
              "glyph": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "angle": {
                "type": "integer",
                "minimum": 0,
                "maximum": 359
              },
              "hiddenUntilAuthorized": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "stateGuards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityVerifiedRequiredBeforeWheel",
        "sysadminRequiresLocalOfflineAuthorization",
        "safeNeutralOnGuardFailure"
      ],
      "properties": {
        "identityVerifiedRequiredBeforeWheel": {
          "type": "boolean"
        },
        "sysadminRequiresLocalOfflineAuthorization": {
          "type": "boolean"
        },
        "safeNeutralOnGuardFailure": {
          "type": "boolean"
        }
      }
    }
  }
}
