{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-enterprise/v3/migration-map.contract.v3.schema.json",
  "title": "Monadoblade profile migration map contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "legacySources",
    "mappings",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "contractId": {
      "const": "monadoblade-profile-migration-map-v3"
    },
    "legacySources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "path"
        ],
        "properties": {
          "version": {
            "enum": [
              "v1",
              "v2"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceVersion",
          "sourceProfileId",
          "targetProfileId",
          "strategy",
          "reason"
        ],
        "properties": {
          "sourceVersion": {
            "enum": [
              "v1",
              "v2"
            ]
          },
          "sourceProfileId": {
            "type": "string",
            "minLength": 1
          },
          "targetProfileId": {
            "enum": [
              "core",
              "developer",
              "studio",
              "gamer",
              "ai-server",
              "sysadmin"
            ]
          },
          "strategy": {
            "enum": [
              "direct",
              "merge",
              "rename"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyArtifactsRemainUnmodified",
        "noHistoryRewrite",
        "targetProfileSetIsSix"
      ],
      "properties": {
        "legacyArtifactsRemainUnmodified": {
          "const": true
        },
        "noHistoryRewrite": {
          "const": true
        },
        "targetProfileSetIsSix": {
          "const": true
        }
      }
    }
  }
}
