{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-enterprise/v3/integration-projection.contract.v3.schema.json",
  "title": "Monadoblade integration projection contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "executionMode",
    "directExternalDeliveryEnabled",
    "executionTriggersAllowed",
    "normalizedEnvelope",
    "idempotency",
    "surfaces",
    "projectionRules",
    "prohibitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "contractId": {
      "const": "monadoblade-integration-projection-v3"
    },
    "executionMode": {
      "const": "projection-only"
    },
    "directExternalDeliveryEnabled": {
      "const": false
    },
    "executionTriggersAllowed": {
      "const": false
    },
    "normalizedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaReference",
        "requiredFields"
      ],
      "properties": {
        "schemaReference": {
          "const": "config/integrations/event-contract.schema.json"
        },
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "normalization",
        "inputFields",
        "keyTemplate"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "inputFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "keyTemplate": {
          "type": "string",
          "pattern": "^sha256\\(normalized-length-prefixed:"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linear",
        "slack",
        "teams",
        "sharepoint",
        "azure-devops"
      ],
      "properties": {
        "linear": {
          "$ref": "#/$defs/surface"
        },
        "slack": {
          "$ref": "#/$defs/surface"
        },
        "teams": {
          "$ref": "#/$defs/surface"
        },
        "sharepoint": {
          "$ref": "#/$defs/surface"
        },
        "azure-devops": {
          "$ref": "#/$defs/surface"
        }
      }
    },
    "projectionRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "routeId",
          "source",
          "eventType",
          "targets",
          "operation",
          "linkTypes",
          "requiresApproval",
          "payloadMode"
        ],
        "properties": {
          "routeId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$"
          },
          "source": {
            "const": "github"
          },
          "eventType": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "linear",
                "slack",
                "teams",
                "sharepoint",
                "azure-devops"
              ]
            }
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "linkTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "pull-request",
                "check-suite",
                "artifact",
                "evidence-record",
                "governed-document"
              ]
            }
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "payloadMode": {
            "const": "links-only"
          }
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "mode",
        "projectionOnly",
        "triggersExecution"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "projectionOnly": {
          "const": true
        },
        "triggersExecution": {
          "const": false
        }
      }
    }
  }
}
