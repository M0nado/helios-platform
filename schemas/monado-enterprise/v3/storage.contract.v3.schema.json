{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-enterprise/v3/storage.contract.v3.schema.json",
  "title": "Monadoblade storage contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "executionPolicy",
    "disks",
    "usbWizardRoutes",
    "workflowOwnership",
    "guardrails",
    "forbiddenRuntimeActions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "contractId": {
      "const": "monadoblade-storage-contract-v3"
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "destructiveApplyDefault",
        "requireWhatIf",
        "requireApproval",
        "requireRollbackPlan",
        "requireImmutableEvidence"
      ],
      "properties": {
        "mode": {
          "const": "proposal-only"
        },
        "destructiveApplyDefault": {
          "const": false
        },
        "requireWhatIf": {
          "const": true
        },
        "requireApproval": {
          "const": true
        },
        "requireRollbackPlan": {
          "const": true
        },
        "requireImmutableEvidence": {
          "const": true
        }
      }
    },
    "disks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "volumes"
            ],
            "properties": {
              "id": {
                "const": "disk0"
              },
              "volumes": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "preferredLetter",
                    "label"
                  ],
                  "properties": {
                    "preferredLetter": {
                      "const": "X"
                    },
                    "label": {
                      "const": "CORE_CROSS"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "virtualDisks"
            ],
            "properties": {
              "id": {
                "const": "disk1"
              },
              "virtualDisks": {
                "type": "array",
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "preferredLetter"
                      ],
                      "properties": {
                        "preferredLetter": {
                          "const": "D"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "preferredLetter",
                        "autoMount"
                      ],
                      "properties": {
                        "preferredLetter": {
                          "const": "V"
                        },
                        "autoMount": {
                          "const": false
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "usbWizardRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "requestStoragePlan",
        "applyRouteEnabled"
      ],
      "properties": {
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path",
            "mode",
            "writesEnabled",
            "requireDeviceEnumeration"
          ],
          "properties": {
            "method": {
              "const": "GET"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "const": "dry-run"
            },
            "writesEnabled": {
              "const": false
            },
            "requireDeviceEnumeration": {
              "const": true
            }
          }
        },
        "requestStoragePlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path",
            "mode",
            "writesEnabled",
            "requiresApproval",
            "requireDeviceIdentity",
            "emitsEvidenceLink"
          ],
          "properties": {
            "method": {
              "const": "POST"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "const": "proposal-only"
            },
            "writesEnabled": {
              "const": false
            },
            "requiresApproval": {
              "const": true
            },
            "requireDeviceIdentity": {
              "const": true
            },
            "emitsEvidenceLink": {
              "const": true
            }
          }
        },
        "applyRouteEnabled": {
          "const": false
        }
      }
    },
    "workflowOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery",
        "quarantine"
      ],
      "properties": {
        "recovery": {
          "const": "sysadmin"
        },
        "quarantine": {
          "const": "sysadmin"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denyBlindDiskClear",
        "denyUnreviewedFormat",
        "denyAutoMountVault",
        "denyPhysicalUsbWritesFromWizard",
        "requirePhysicalApprovalForApply",
        "requireCorrelationId",
        "requireRollbackEvidenceLink"
      ],
      "properties": {
        "denyBlindDiskClear": {
          "const": true
        },
        "denyUnreviewedFormat": {
          "const": true
        },
        "denyAutoMountVault": {
          "const": true
        },
        "denyPhysicalUsbWritesFromWizard": {
          "const": true
        },
        "requirePhysicalApprovalForApply": {
          "const": true
        },
        "requireCorrelationId": {
          "const": true
        },
        "requireRollbackEvidenceLink": {
          "const": true
        }
      }
    },
    "forbiddenRuntimeActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "physical-usb-write"
      }
    }
  }
}
