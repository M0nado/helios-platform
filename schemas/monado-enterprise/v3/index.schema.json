{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-enterprise/v3/index.schema.json",
  "title": "Monadoblade six-profile delivery fabric v3 index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "status",
    "historicalInputs",
    "executionMode",
    "destructiveApplyDefault",
    "requiresApprovalEvidence",
    "contracts",
    "migrationMap",
    "profileManifestDirectory",
    "profileManifestSchema",
    "relatedIssues",
    "governanceGates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "contractId": {
      "const": "monadoblade-six-profile-delivery-fabric-v3"
    },
    "status": {
      "const": "authoritative"
    },
    "historicalInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionMode": {
      "const": "proposal-only"
    },
    "destructiveApplyDefault": {
      "const": false
    },
    "requiresApprovalEvidence": {
      "const": true
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "experience",
        "storage",
        "integrationProjection",
        "repositoryMap",
        "libraries"
      ],
      "properties": {
        "profiles": {
          "type": "string",
          "minLength": 1
        },
        "experience": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "integrationProjection": {
          "type": "string",
          "minLength": 1
        },
        "repositoryMap": {
          "type": "string",
          "minLength": 1
        },
        "libraries": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migrationMap": {
      "type": "string",
      "minLength": 1
    },
    "profileManifestDirectory": {
      "type": "string",
      "minLength": 1
    },
    "profileManifestSchema": {
      "type": "string",
      "minLength": 1
    },
    "relatedIssues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "governanceGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "trackingIssue",
          "status"
        ],
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1
          },
          "trackingIssue": {
            "type": "integer",
            "minimum": 1
          },
          "trackingPullRequest": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
