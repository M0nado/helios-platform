{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-enterprise/v2/repository-map.contract.v2.schema.json",
  "title": "Monado enterprise repository map contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "canonicalRepository",
    "crossRepositorySource",
    "ownershipBoundaries",
    "dedicatedTargets",
    "codeownersReadyPaths",
    "projectStatusSources",
    "nonAuthorities",
    "constraints"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contractId": {
      "const": "monado-enterprise-repository-map-v2"
    },
    "canonicalRepository": {
      "const": "M0nado/helios-platform"
    },
    "crossRepositorySource": {
      "const": "config/integrations/repositories.json"
    },
    "ownershipBoundaries": {
      "type": "array",
      "minItems": 1,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "repository"
            ],
            "properties": {
              "repository": {
                "const": "Heli0s-Dynamics/adaptive-multibrain-bootstrap"
              }
            }
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "role",
          "authority"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dedicatedTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gui",
        "usbWizard"
      ],
      "properties": {
        "gui": {
          "$ref": "#/$defs/dedicatedTarget"
        },
        "usbWizard": {
          "$ref": "#/$defs/dedicatedTarget"
        }
      }
    },
    "codeownersReadyPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "ownerRole",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ownerRole": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "projectStatusSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubIssue",
        "linearIssue",
        "sharepointRecord",
        "slackPolicy"
      ],
      "properties": {
        "githubIssue": {
          "type": "string",
          "format": "uri"
        },
        "linearIssue": {
          "type": "string",
          "format": "uri"
        },
        "sharepointRecord": {
          "type": "string",
          "minLength": 1
        },
        "slackPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonAuthorities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noCompetingPlatformRoots",
        "noDirectToMainWrites",
        "noSecretMaterialInContracts"
      ],
      "properties": {
        "noCompetingPlatformRoots": {
          "const": true
        },
        "noDirectToMainWrites": {
          "const": true
        },
        "noSecretMaterialInContracts": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "dedicatedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItems",
        "ownership",
        "integrationMode"
      ],
      "properties": {
        "workItems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "ownership": {
          "type": "string",
          "minLength": 1
        },
        "integrationMode": {
          "const": "linked-not-duplicated"
        }
      }
    }
  }
}
