{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios-platform.dev/schemas/monado-enterprise/v2/storage.contract.v2.schema.json",
  "title": "Monado enterprise storage contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "executionPolicy",
    "exactSizeLock",
    "disks",
    "guardrails",
    "forbiddenRuntimeActions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contractId": {
      "const": "monado-enterprise-storage-v2"
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "destructiveApplyDefault",
        "requireWhatIf",
        "requireApproval",
        "requireRollbackPlan",
        "requireImmutableEvidence"
      ],
      "properties": {
        "mode": {
          "const": "proposal-only"
        },
        "destructiveApplyDefault": {
          "const": false
        },
        "requireWhatIf": {
          "const": true
        },
        "requireApproval": {
          "const": true
        },
        "requireRollbackPlan": {
          "const": true
        },
        "requireImmutableEvidence": {
          "const": true
        }
      }
    },
    "exactSizeLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "applyBlocked",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "applyBlocked": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "disks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "role",
              "volumes"
            ],
            "properties": {
              "id": {
                "const": "disk0"
              },
              "volumes": {
                "type": "array",
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "preferredLetter",
                        "label"
                      ],
                      "properties": {
                        "preferredLetter": {
                          "const": "X"
                        },
                        "label": {
                          "const": "CORE_CROSS"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "role",
              "domainsVolume",
              "virtualDisks"
            ],
            "properties": {
              "id": {
                "const": "disk1"
              },
              "virtualDisks": {
                "type": "array",
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "preferredLetter",
                        "type",
                        "allocation",
                        "fileSystem",
                        "hostedOnVolume"
                      ],
                      "properties": {
                        "preferredLetter": {
                          "const": "D"
                        },
                        "type": {
                          "const": "VHDX"
                        },
                        "allocation": {
                          "const": "dynamic"
                        },
                        "fileSystem": {
                          "const": "ReFS"
                        },
                        "hostedOnVolume": {
                          "const": "MONADO_DOMAINS"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "required": [
                        "preferredLetter",
                        "autoMount",
                        "type",
                        "allocation",
                        "fileSystem",
                        "hostedOnVolume",
                        "bitLocker"
                      ],
                      "properties": {
                        "preferredLetter": {
                          "const": "V"
                        },
                        "autoMount": {
                          "const": false
                        },
                        "type": {
                          "const": "VHDX"
                        },
                        "allocation": {
                          "const": "dynamic"
                        },
                        "fileSystem": {
                          "const": "NTFS"
                        },
                        "hostedOnVolume": {
                          "const": "MONADO_DOMAINS"
                        },
                        "bitLocker": {
                          "const": "required"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denyBlindDiskClear",
        "denyUnreviewedFormat",
        "denyAutoMountVault",
        "requirePhysicalApprovalForApply",
        "requireCorrelationId",
        "requireRollbackEvidenceLink"
      ],
      "properties": {
        "denyBlindDiskClear": {
          "const": true
        },
        "denyUnreviewedFormat": {
          "const": true
        },
        "denyAutoMountVault": {
          "const": true
        },
        "requirePhysicalApprovalForApply": {
          "const": true
        },
        "requireCorrelationId": {
          "const": true
        },
        "requireRollbackEvidenceLink": {
          "const": true
        }
      }
    },
    "forbiddenRuntimeActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
