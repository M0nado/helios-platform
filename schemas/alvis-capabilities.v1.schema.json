{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.local/alvis-capabilities.v1.schema.json",
  "title": "ALVIS capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agent",
    "capabilities",
    "directExecutorToolsDenied",
    "approvalModel"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "1.0.0"
    },
    "agent": {
      "const": "ALVIS"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search",
        "plan",
        "request"
      ],
      "properties": {
        "search": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "request": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "directExecutorToolsDenied": {
      "type": "boolean"
    },
    "approvalModel": {
      "type": "string",
      "minLength": 1
    }
  }
}
