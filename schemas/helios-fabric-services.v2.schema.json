{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.local/helios-fabric-services.v2.schema.json",
  "title": "HELIOS fabric services v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fabricId",
    "contractMode",
    "libraries",
    "governance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "2.0.0"
    },
    "fabricId": {
      "const": "monadoblade-delivery-fabric"
    },
    "contractMode": {
      "const": "deterministic-and-versioned"
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failClosed",
        "idempotentWritesOnly",
        "approvalRequiredForPrivilegedApply",
        "noDirectExecutorSurfaceInPresentationLayers"
      ],
      "properties": {
        "failClosed": {
          "type": "boolean"
        },
        "idempotentWritesOnly": {
          "type": "boolean"
        },
        "approvalRequiredForPrivilegedApply": {
          "const": true
        },
        "noDirectExecutorSurfaceInPresentationLayers": {
          "type": "boolean"
        }
      }
    }
  }
}
