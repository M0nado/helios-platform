{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.invalid/hermes-xcore-capability-bindings-v1.schema.json",
  "title": "HELIOS Hermes/XCore capability bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractSchema",
    "schemaVersion",
    "contractId",
    "surfaces",
    "authoritativeDeploymentSurfaces",
    "authoritativeApprovalSurfaces",
    "nonAuthoritativeSurfaces",
    "advisoryOnlySurfaces"
  ],
  "properties": {
    "contractSchema": {
      "const": "schemas/hermes-xcore-capability-bindings-v1.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contractId": {
      "const": "helios-hermes-xcore-capability-bindings-v1"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "authoritativeDeploymentSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authoritativeApprovalSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonAuthoritativeSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "advisoryOnlySurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "canRequest",
        "canApprove",
        "canDeploy",
        "canExecuteApprovalWorkflow",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "canRequest": {
          "type": "boolean"
        },
        "canApprove": {
          "type": "boolean"
        },
        "canDeploy": {
          "type": "boolean"
        },
        "canExecuteApprovalWorkflow": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
