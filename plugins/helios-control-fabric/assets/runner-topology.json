{
  "schemaVersion": 1,
  "validation": {
    "provider": "github-hosted",
    "labels": [
      "ubuntu-latest",
      "windows-latest"
    ],
    "permissions": "read-only",
    "publishArtifacts": true
  },
  "release": {
    "provider": "github-hosted",
    "labels": [
      "ubuntu-latest"
    ],
    "environment": "azure-dev",
    "permissions": [
      "contents:read",
      "id-token:write"
    ],
    "immutableImageRequired": true
  },
  "selfHosted": {
    "enabled": true,
    "activationMode": "manual-protected-environment-approval",
    "groups": [
      {
        "name": "hermes-xcore9-local",
        "labels": [
          "self-hosted",
          "linux",
          "x64",
          "local",
          "hermes-fleet",
          "xcore9"
        ],
        "ephemeral": true,
        "fleet": "hermes",
        "runners": [
          "xcore9-01",
          "xcore9-02",
          "xcore9-03",
          "xcore9-04"
        ],
        "purpose": "local-runner execution for Hermes fleet tasks"
      }
    ],
    "enablementRequirements": [
      "dedicated runner group",
      "ephemeral instances",
      "no shared developer credentials",
      "egress allow-list",
      "protected-environment approval"
    ]
  }
}
