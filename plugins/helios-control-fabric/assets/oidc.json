{
  "schemaVersion": 2,
  "issuer": "https://token.actions.githubusercontent.com",
  "audience": "api://AzureADTokenExchange",
  "repository": "M0nado/helios-platform",
  "environments": [
    "x-tier-dev",
    "x-tier-xcore",
    "x-tier-prod"
  ],
  "subjectResolution": {
    "mode": "authenticated-github-api",
    "apiVersion": "2026-03-10",
    "repositoryEndpoint": "repos/{repository}",
    "policyEndpoint": "repos/{repository}/actions/oidc/customization/sub",
    "requireDefaultTemplate": true,
    "requireImmutablePolicySignal": true,
    "failClosed": true
  },
  "workflowPermissions": {
    "contents": "read",
    "id-token": "write"
  },
  "requiredVariables": [
    "AZURE_CLIENT_ID",
    "AZURE_TENANT_ID",
    "AZURE_SUBSCRIPTION_ID",
    "AZURE_RESOURCE_GROUP"
  ],
  "secretsStoredInGitHub": false,
  "automaticRoleAssignment": false,
  "administratorGates": [
    "create or select the Entra application and service principal",
    "resolve GitHub's effective OIDC policy and create one federated identity credential for the exact protected environment subject",
    "assign least-privilege scope after reviewing the Bicep resource graph",
    "protect the GitHub environment with required reviewers"
  ]
}
