{
  "schemaVersion": 1,
  "issuer": "https://token.actions.githubusercontent.com",
  "audience": "api://AzureADTokenExchange",
  "repository": "M0nado/helios-platform",
  "subjects": {
    "azure-dev": "repo:M0nado/helios-platform:environment:azure-dev",
    "azure-test": "repo:M0nado/helios-platform:environment:azure-test",
    "azure-prod": "repo:M0nado/helios-platform:environment:azure-prod"
  },
  "workflowPermissions": {
    "contents": "read",
    "id-token": "write"
  },
  "requiredVariables": [
    "AZURE_CLIENT_ID",
    "AZURE_TENANT_ID",
    "AZURE_SUBSCRIPTION_ID",
    "AZURE_RESOURCE_GROUP"
  ],
  "secretsStoredInGitHub": false,
  "automaticRoleAssignment": false,
  "administratorGates": [
    "create or select the Entra application and service principal",
    "create one federated identity credential for the exact protected environment subject",
    "assign least-privilege scope after reviewing the Bicep resource graph",
    "protect the GitHub environment with required reviewers"
  ]
}
