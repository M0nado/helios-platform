{
  "name": "HELIOS Developer Cockpit",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0.423"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.18.0",
      "npmVersion": "11.16.0",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "7.4"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "2.88.0",
      "installBicep": true,
      "bicepVersion": "v0.45.15"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.96.0"
    }
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.devcontainer/node_modules/.bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code",
        "ms-edgedevtools.vscode-edge-devtools",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.codespaces",
        "ms-vscode-remote.remote-containers",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-vscode.powershell",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azureappservice",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-azure-github-copilot",
        "ms-azuretools.vscode-azure-mcp-server",
        "teamsdevapp.ms-teams-vscode-extension",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "davidanson.vscode-markdownlint"
      ],
      "settings": {
        "chat.mcp.enabled": true,
        "dotnet.defaultSolution": "monado/helios-control/Helios.Connect.sln",
        "azureMcp.readOnly": true,
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "editor.formatOnSave": true,
        "files.autoSave": "onFocusChange"
      }
    }
  },
  "forwardPorts": [
    3000,
    5000,
    5173,
    8080,
    8443,
    5080
  ],
  "portsAttributes": {
    "3000": {
      "label": "Web UI",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "5000": {
      "label": "API server",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "8080": {
      "label": "HELIOS dashboard",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "8443": {
      "label": "Secure API",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "5080": {
      "label": "HELIOS local MCP and setup wizard",
      "protocol": "http",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash scripts/dev/bootstrap-cockpit.sh",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
