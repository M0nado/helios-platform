<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/HELIOS.Platform/HELIOS.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="HELIOS.Platform.Tests/AI/**/*.cs" />
    <Compile Remove="HELIOS.Platform.Tests/Cloud/**/*.cs" />
    <Compile Remove="HELIOS.Platform.Tests/FileManagement/**/*.cs" />
    <Compile Remove="HELIOS.Platform.Tests/Software/**/*.cs" />
    <Compile Remove="Themes/**/*.cs" />
    <Compile Remove="Phase3Phase5IntegrationTests.cs" />
    <Compile Remove="ThemeSystemTests.cs" />
    <Compile Remove="HELIOS.Platform.Tests/Phase2ServiceTests.cs" />
    <Compile Remove="HELIOS.Platform.Tests/MonitoringTests.cs" />
    <Compile Remove="Phase8Stream8OptimizationTests.cs" />
    <Compile Remove="SandboxTests.cs" />
    <Compile Remove="Phase5/Global/Phase5GlobalTests.cs" />
  </ItemGroup>

</Project>
